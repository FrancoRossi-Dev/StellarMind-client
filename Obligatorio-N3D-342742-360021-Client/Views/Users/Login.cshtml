@model Obligatorio_N3D_342742_360021_Client.Models.LogInUserDto

@{
    ViewData["Title"] = "Sign In";
    ViewData["HideTopbar"] = true;
    // The API wake-up ping + status card now live in _ServerStatus (rendered by _Layout),
    // which fires on the first page of the session — including this one.
}

<div class="login-page">
    <div class="login-card">
        <div class="login-card__glow" aria-hidden="true"></div>

        <div class="login-card__brand">
            <span class="login-card__brand-icon"><i class="fa-solid fa-star-of-life"></i></span>
            <span class="login-card__brand-name">StellarMinds</span>
        </div>

        <h1 class="login-card__title">Welcome back</h1>
        <p class="login-card__sub">Sign in to your account to continue</p>

        <form asp-controller="Users" asp-action="Login" method="post" class="form-stack">
            <div class="field">
                <label asp-for="username" class="field__label">Username</label>
                <input asp-for="username"
                       type="text"
                       class="input"
                       autocomplete="username"
                       placeholder="your username"
                       required />
            </div>
            <div class="field">
                <label asp-for="password" class="field__label">Password</label>
                <div class="input-wrap">
                    <input asp-for="password"
                           id="passwordInput"
                           type="password"
                           class="input"
                           autocomplete="current-password"
                           placeholder="••••••••"
                           required />
                    <button type="button"
                            class="input-wrap__toggle"
                            aria-label="Show password"
                            onclick="(function(btn){
                                var inp = document.getElementById('passwordInput');
                                var showing = inp.type === 'text';
                                inp.type = showing ? 'password' : 'text';
                                btn.querySelector('i').className = showing ? 'fa-regular fa-eye' : 'fa-regular fa-eye-slash';
                                btn.setAttribute('aria-label', showing ? 'Show password' : 'Hide password');
                            })(this)"><i class="fa-regular fa-eye"></i></button>
                </div>
            </div>
            <button id="login-submit" type="submit" class="btn btn--primary btn--full" style="margin-top: 0.5rem;">
                Sign in
            </button>

            <p id="login-progress" class="login-progress" role="status" aria-live="polite" hidden>
                <i class="fa-solid fa-circle-notch fa-spin"></i>
                <span data-progress-text></span>
            </p>
        </form>

        @await Html.PartialAsync("_DevCredentials")
    </div>
</div>

<script>
(function () {
    var form = document.getElementById('login-submit').closest('form');
    var hint = document.getElementById('login-progress');
    var text = hint.querySelector('[data-progress-text]');
    var timers = [];

    // Render's free tier sleeps the API when idle; the first login can wait on a
    // cold start well past a few seconds. Reassure the user instead of leaving
    // them staring at a silent spinner.
    var STAGES = [
        { after: 5000,  msg: "Almost there; the server may be waking up from sleep." },
        { after: 15000, msg: "Still working on it; the first connection can take up to a minute." }
    ];

    form.addEventListener('submit', function () {
        STAGES.forEach(function (stage) {
            timers.push(setTimeout(function () {
                text.textContent = stage.msg;
                hint.hidden = false;
                requestAnimationFrame(function () { hint.classList.add('is-visible'); });
            }, stage.after));
        });
    });

    // If the browser restores this page from bfcache after a failed/back nav,
    // clear any pending timers so a stale message can't flash.
    window.addEventListener('pageshow', function () {
        timers.forEach(clearTimeout);
        timers = [];
    });
})();
</script>

