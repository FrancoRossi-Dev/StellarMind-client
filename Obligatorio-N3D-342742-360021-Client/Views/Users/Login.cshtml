@model Obligatorio_N3D_342742_360021_Client.Models.LogInUserDto
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    ViewData["Title"] = "Sign In";
    ViewData["HideTopbar"] = true;
    var apiBaseUrl = Configuration["ApiBaseUrl"]?.TrimEnd('/');
}

@if (!string.IsNullOrEmpty(apiBaseUrl))
{
    <script>
        // Fire-and-forget wake-up ping: Render spins the API down after idle periods,
        // so this kicks off the cold start as soon as the login page loads instead of
        // waiting until the user submits the form. Response is ignored on purpose.
        (function () {
            try {
                fetch('@apiBaseUrl/health', { mode: 'no-cors', cache: 'no-store' }).catch(function () {});
            } catch (e) {}
        })();
    </script>
}

<div class="login-page">
    <div class="login-card">
        <div class="login-card__glow" aria-hidden="true"></div>

        <div class="login-card__brand">
            <span class="login-card__brand-icon"><i class="fa-solid fa-star-of-life"></i></span>
            <span class="login-card__brand-name">StellarMinds</span>
        </div>

        <h1 class="login-card__title">Welcome back</h1>
        <p class="login-card__sub">Sign in to your account to continue</p>

        <form asp-controller="Users" asp-action="Login" method="post" class="form-stack">
            <div class="field">
                <label asp-for="username" class="field__label">Username</label>
                <input asp-for="username"
                       type="text"
                       class="input"
                       autocomplete="username"
                       placeholder="your username"
                       required />
            </div>
            <div class="field">
                <label asp-for="password" class="field__label">Password</label>
                <div class="input-wrap">
                    <input asp-for="password"
                           id="passwordInput"
                           type="password"
                           class="input"
                           autocomplete="current-password"
                           placeholder="••••••••"
                           required />
                    <button type="button"
                            class="input-wrap__toggle"
                            aria-label="Show password"
                            onclick="(function(btn){
                                var inp = document.getElementById('passwordInput');
                                var showing = inp.type === 'text';
                                inp.type = showing ? 'password' : 'text';
                                btn.querySelector('i').className = showing ? 'fa-regular fa-eye' : 'fa-regular fa-eye-slash';
                                btn.setAttribute('aria-label', showing ? 'Show password' : 'Hide password');
                            })(this)"><i class="fa-regular fa-eye"></i></button>
                </div>
            </div>
            <button id="login-submit" type="submit" class="btn btn--primary btn--full" style="margin-top: 0.5rem;">
                Sign in
            </button>
        </form>

        @await Html.PartialAsync("_DevCredentials")
    </div>
</div>

