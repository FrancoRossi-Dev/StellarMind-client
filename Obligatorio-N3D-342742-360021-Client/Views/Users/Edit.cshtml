@model Obligatorio_N3D_342742_360021_Client.Models.UserVM

@{
    ViewData["Title"] = "Edit Member";
}

<div class="page-head">
    <div>
        <h1 class="page-head__title">Edit Member</h1>
        <p class="page-head__sub">Update account details for @Model?.fullName</p>
    </div>
    <a class="btn btn--ghost" asp-controller="Users" asp-action="Index">← Back</a>
</div>


<div class="card" style="max-width: 680px;">
    <div class="card__body">
        <form asp-controller="Users"
              asp-action="Edit"
              asp-route-id="@Model?.UserId"
              method="post"
              class="form-stack">

            <input type="hidden" name="UserId" value="@Model?.UserId" />

            <div class="form-grid">
                <div class="field">
                    <label asp-for="fullName" class="field__label">Full Name</label>
                    <input asp-for="fullName" type="text" class="input" placeholder="Jane Doe" required />
                </div>
                <div class="field">
                    <label asp-for="username" class="field__label">Username</label>
                    <input asp-for="username" type="text" class="input" placeholder="janedoe" required />
                </div>
                <div class="field">
                    <label asp-for="email" class="field__label">Email</label>
                    <input asp-for="email" type="email" class="input" placeholder="jane@example.com" required />
                </div>
                <div class="field">
                    <label asp-for="phoneNumber" class="field__label">Phone Number</label>
                    <input asp-for="phoneNumber" type="tel" class="input" placeholder="+1 555 000 0000" />
                </div>
                <div class="field" style="grid-column: span 2;">
                    <label asp-for="address" class="field__label">Address</label>
                    <input asp-for="address" type="text" class="input" placeholder="123 Main St, City" />
                </div>
                <div class="field">
                    <label asp-for="role" class="field__label">Role</label>
                    <select asp-for="role" class="select" required>
                        <option value="Admin">Admin</option>
                        <option value="Coordinator">Coordinator</option>
                        <option value="Member">Member</option>
                    </select>
                </div>
                <div class="field">
                    <label asp-for="password" class="field__label">Password</label>
                    <div class="input-wrap">
                        <input asp-for="password"
                               type="password"
                               class="input"
                               id="pw-input"
                               placeholder="Leave blank to keep current"
                               oninput="checkPw(this.value)" />
                        <button type="button" class="input-wrap__toggle" id="pw-toggle"
                                onclick="togglePw()" aria-label="Toggle password visibility">
                            <i class="fa-solid fa-eye" id="pw-icon"></i>
                        </button>
                    </div>
                    <span class="field__hint">Leave blank to keep the current password.</span>
                    <div class="pw-rules" id="pw-rules" aria-live="polite">
                        <span class="pw-rule" data-rule="length">At least 8 characters</span>
                        <span class="pw-rule" data-rule="upper">Uppercase letter</span>
                        <span class="pw-rule" data-rule="lower">Lowercase letter</span>
                        <span class="pw-rule" data-rule="digit">Number</span>
                        <span class="pw-rule" data-rule="special">Special character (!&#64;#$%^&amp;*)</span>
                    </div>
                </div>
            </div>

            <div style="display:flex; gap: var(--p-space-3); margin-top: var(--p-space-2);">
                <button id="edit-submit" type="submit" class="btn btn--primary">Save changes</button>
                <a asp-controller="Users" asp-action="Index" class="btn btn--secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
function checkPw(val) {
    if (!val) {
        document.querySelectorAll('.pw-rule').forEach(el => el.classList.remove('ok'));
        return;
    }
    const rules = {
        length:  val.length >= 8,
        upper:   /[A-Z]/.test(val),
        lower:   /[a-z]/.test(val),
        digit:   /[0-9]/.test(val),
        special: /[!@@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]/.test(val)
    };
    for (const [key, ok] of Object.entries(rules)) {
        const el = document.querySelector(`.pw-rule[data-rule="${key}"]`);
        if (el) el.classList.toggle('ok', ok);
    }
}

function togglePw() {
    const input = document.getElementById('pw-input');
    const icon  = document.getElementById('pw-icon');
    if (input.type === 'password') {
        input.type = 'text';
        icon.className = 'fa-solid fa-eye-slash';
    } else {
        input.type = 'password';
        icon.className = 'fa-solid fa-eye';
    }
}

(function () {
    const btn      = document.getElementById('edit-submit');
    const required = ['fullName', 'username', 'email', 'role'];
    function check() {
        btn.disabled = required.some(n => {
            const el = document.querySelector(`[name="${n}"]`);
            return !el || !el.value.trim();
        });
    }
    required.forEach(n => {
        const el = document.querySelector(`[name="${n}"]`);
        if (el) el.addEventListener(el.tagName === 'SELECT' ? 'change' : 'input', check);
    });
})();
</script>
}
