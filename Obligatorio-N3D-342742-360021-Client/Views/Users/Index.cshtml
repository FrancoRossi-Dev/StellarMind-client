@model List<Obligatorio_N3D_342742_360021_Client.Models.UserVM>

@{
    ViewData["Title"] = "Users";
}

<h2 class="mb-4">Users</h2>

@if (ViewBag.msg != null)
{
    <div class="alert alert-danger">@ViewBag.msg</div>
}
else if (Model == null || !Model.Any())
{
    <p>No users found.</p>
}
else
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Full Name</th>
                <th>Username</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Address</th>
                <th>Role</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.fullName</td>
                    <td>@user.username</td>
                    <td>@user.email</td>
                    <td>@user.phoneNumber</td>
                    <td>@user.address</td>
                    <td>@user.role</td>
                </tr>
            }
        </tbody>
    </table>
}
