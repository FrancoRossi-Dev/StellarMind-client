@model List<Obligatorio_N3D_342742_360021_Client.Models.UserVM>

@{
    ViewData["Title"] = "Users";
    string? currentSearch = ViewBag.Search as string;
    string? currentRole   = ViewBag.Role as string ?? "All";
    bool isAdmin = Context.Session.GetString("UserRole") == "Admin";

    string TabClass(string tab) =>
        string.Equals(tab, currentRole, StringComparison.OrdinalIgnoreCase)
            ? "seg-filter__btn active"
            : "seg-filter__btn";

    string RoleChipClass(string? role) => role switch {
        "Admin"       => "chip chip--accent",
        "Coordinator" => "chip chip--info",
        _             => "chip chip--plain"
    };

    string Initials(string? name) {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return (parts.Length >= 2
            ? $"{parts[0][0]}{parts[^1][0]}"
            : parts[0][0].ToString()).ToUpper();
    }

    string TabUrl(string tab) {
        var q = Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(
            Url.Action("Index", "Users")!,
            new Dictionary<string, string?> {
                ["search"] = string.IsNullOrEmpty(currentSearch) ? null : currentSearch,
                ["role"]   = tab == "All" ? null : tab
            });
        return q;
    }
}

<div class="page-head">
    <div>
        <h1 class="page-head__title">Members</h1>
        <p class="page-head__sub">Manage observatory member accounts</p>
    </div>
    @if (isAdmin)
    {
        <a class="btn btn--primary" asp-controller="Users" asp-action="Create">+ New member</a>
    }
</div>

<form method="get" asp-controller="Users" asp-action="Index" class="toolbar">
    <div class="search">
        <span class="search__icon"><i class="fa-solid fa-magnifying-glass"></i></span>
        <input type="search"
               name="search"
               class="input search__input"
               placeholder="Search by name, username or email…"
               value="@currentSearch" />
        <input type="hidden" name="role" value="@(currentRole == "All" ? "" : currentRole)" />
    </div>
    <button type="submit" class="btn btn--secondary btn--sm">Search</button>
    @if (!string.IsNullOrEmpty(currentSearch) || (currentRole != "All" && !string.IsNullOrEmpty(currentRole)))
    {
        <a class="btn btn--ghost btn--sm" asp-controller="Users" asp-action="Index">Clear</a>
    }
</form>

<div style="margin-bottom: 1rem;">
    <div class="seg-filter">
        <a href="@TabUrl("All")" class="@TabClass("All")">All</a>
        <a href="@TabUrl("Admin")" class="@TabClass("Admin")">Admin</a>
        <a href="@TabUrl("Coordinator")" class="@TabClass("Coordinator")">Coordinator</a>
        <a href="@TabUrl("Member")" class="@TabClass("Member")">Member</a>
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <div class="card">
        <div class="empty">
            <div class="empty__icon"><i class="fa-solid fa-user"></i></div>
            <p class="empty__title">No members found</p>
            <p class="empty__body">
                @if (!string.IsNullOrEmpty(currentSearch) || (currentRole != "All"))
                {
                    <text>Try adjusting your search or filter.</text>
                }
                else
                {
                    <text>No members have been added yet.</text>
                }
            </p>
        </div>
    </div>
}
else
{
    <div class="table-wrap">
        <table class="tbl">
            <thead>
                <tr>
                    <th>Member</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Role</th>
                    @if (isAdmin)
                    {
                        <th style="text-align:right;">Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>
                            <div class="tbl__cell--user">
                                <span class="avatar">@Initials(user.fullName)</span>
                                <div>
                                    <div class="tbl__name">@user.fullName</div>
                                    <div class="tbl__sub">@@@user.username</div>
                                </div>
                            </div>
                        </td>
                        <td style="color: var(--color-text-secondary);">@user.email</td>
                        <td style="color: var(--color-text-secondary);">@user.phoneNumber</td>
                        <td><span class="@RoleChipClass(user.role)">@user.role</span></td>
                        @if (isAdmin)
                        {
                            <td>
                                <div class="tbl__actions">
                                    <a class="btn btn--secondary btn--sm"
                                       asp-controller="Users"
                                       asp-action="Edit"
                                       asp-route-id="@user.UserId">Edit</a>
                                    <form method="post"
                                          asp-controller="Users"
                                          asp-action="Delete"
                                          asp-route-id="@user.UserId"
                                          onsubmit="return confirm('Delete @user.fullName?');">
                                        <button type="submit" class="btn btn--danger btn--sm">Delete</button>
                                    </form>
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
