@model List<Obligatorio_N3D_342742_360021_Client.Models.ObservationNightVM>

@{
    ViewData["Title"] = "Observation Nights";
    string? role   = Context.Session.GetString("UserRole");
    bool canCreate = role == "Member";
    bool canEdit   = role == "Admin" || role == "Member";

    string FmtDate(string? raw) {
        if (string.IsNullOrWhiteSpace(raw)) return "—";
        return DateTime.TryParse(raw, out var d) ? d.ToString("MMM d, yyyy  HH:mm") : raw;
    }
}

<div class="page-head">
    <div>
        <h1 class="page-head__title">Observation Nights</h1>
        <p class="page-head__sub">Logged observation sessions across the club</p>
    </div>
    @if (canCreate)
    {
        <a class="btn btn--primary" asp-controller="ObservationNights" asp-action="Create">+ Log night</a>
    }
</div>

@if (Model == null || !Model.Any())
{
    <div class="card">
        <div class="empty">
            <div class="empty__icon">🌙</div>
            <p class="empty__title">No observation nights logged</p>
            <p class="empty__body">Clear skies are waiting — log your first session to get started.</p>
        </div>
    </div>
}
else
{
    <div class="table-wrap">
        <table class="tbl">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Location</th>
                    <th>Notes</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var night in Model)
                {
                    <tr>
                        <td style="white-space:nowrap; color: var(--color-text-secondary); font-variant-numeric: tabular-nums;">
                            @FmtDate(night.Date)
                        </td>
                        <td class="tbl__name">@night.Location</td>
                        <td style="color: var(--color-text-muted); max-width: 260px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                            title="@night.Notes">
                            @night.Notes
                        </td>
                        <td>
                            <div class="tbl__actions">
                                <a class="btn btn--ghost btn--sm"
                                   asp-controller="ObservationNights"
                                   asp-action="Details"
                                   asp-route-id="@night.Id">View</a>
                                @if (canEdit)
                                {
                                    <a class="btn btn--secondary btn--sm"
                                       asp-controller="ObservationNights"
                                       asp-action="Edit"
                                       asp-route-id="@night.Id">Edit</a>
                                    <form method="post"
                                          asp-controller="ObservationNights"
                                          asp-action="Delete"
                                          asp-route-id="@night.Id"
                                          onsubmit="return confirm('Delete this observation night?');">
                                        <button type="submit" class="btn btn--danger btn--sm">Delete</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
