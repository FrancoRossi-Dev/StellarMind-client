@model Obligatorio_N3D_342742_360021_Client.Models.ObservationNightVM

@{
    ViewData["Title"] = "Edit Observation Plan";
    string existingDate = Model?.Date ?? "";
    var coList = ViewBag.CelestialObjects as List<Obligatorio_N3D_342742_360021_Client.Models.CelestialObjectVM> ?? new();
    var coJson = System.Text.Json.JsonSerializer.Serialize(
        coList.ToDictionary(o => o.Id, o => new { o.Id, o.Name, o.Type, o.AparentMagnitude, o.Details })
    );
}

<div class="page-head">
    <div>
        <h1 class="page-head__title">Edit Observation Plan</h1>
        <p class="page-head__sub">Update the details of this planned session</p>
    </div>
    <a class="btn btn--ghost" asp-controller="ObservationNights" asp-action="Index">← Back</a>
</div>

<div class="card" style="max-width: 560px;">
    <div class="card__body">
        <form method="post" asp-controller="ObservationNights" asp-action="Edit" asp-route-id="@Model?.Id" class="form-stack">

            <input type="hidden" name="requestingUserId" value="@Model?.RequestingUserId" />

            <div class="field">
                <label class="field__label" for="date">Date</label>
                <input id="date" name="date" type="text" class="input"
                       value="@Model?.Date" placeholder="Pick a date and time" required />
            </div>

            <div class="field">
                <label class="field__label" for="celestialObjectId">Celestial Object</label>
                <select id="celestialObjectId" name="celestialObjectId" class="input" required>
                    <option value="" disabled>Select a celestial object…</option>
                    @foreach (var obj in coList)
                    {
                        if (obj.Id == Model?.CelestialObject?.Id)
                        {
                            <option value="@obj.Id" selected>@obj.Name</option>
                        }
                        else
                        {
                            <option value="@obj.Id">@obj.Name</option>
                        }
                    }
                </select>
                <div id="co-detail" hidden
                     style="margin-top: var(--p-space-3); padding: var(--p-space-3) var(--p-space-4);
                            background: var(--color-surface-raised); border: 1px solid var(--color-border);
                            border-radius: var(--radius-md);">
                    <div style="display:flex; align-items:center; gap: var(--p-space-2); margin-bottom: var(--p-space-3);">
                        <i class="fa-solid fa-star-half-stroke" style="color: var(--color-accent); font-size: var(--text-sm);"></i>
                        <span id="co-name" style="font-weight: var(--weight-semibold); font-size: var(--text-sm); color: var(--color-text-primary);"></span>
                        <span id="co-type-badge" style="margin-left: auto; font-size: var(--text-xs); font-weight: var(--weight-medium);
                                                        padding: 2px 8px; border-radius: 999px;
                                                        background: var(--color-accent-soft); color: var(--color-accent);"></span>
                    </div>
                    <dl class="detail-list">
                        <dt>Apparent Magnitude</dt>
                        <dd id="co-mag"></dd>
                        <dt>Notes</dt>
                        <dd id="co-details" style="white-space: pre-line;"></dd>
                    </dl>
                </div>
            </div>

            <div class="field">
                <label class="field__label" for="details">Details</label>
                <textarea id="details" name="details" class="textarea" rows="4">@Model?.Details</textarea>
            </div>

            <div style="display:flex; gap: var(--p-space-3); margin-top: var(--p-space-2);">
                <button type="submit" class="btn btn--primary">Save changes</button>
                <a class="btn btn--ghost" asp-controller="ObservationNights" asp-action="Index">Cancel</a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
<script>
const CO_TYPE = {
    1:'Star', 2:'Neutron Star', 3:'White Dwarf', 4:'Black Hole',
    5:'Open Cluster', 6:'Globular Cluster', 7:'Emission Nebula',
    8:'Reflection Nebula', 9:'Planetary Nebula', 10:'Supernova Remnant',
    11:'Galaxy', 12:'Galaxy Cluster', 13:'Planet', 14:'Dwarf Planet',
    15:'Moon', 16:'Asteroid', 17:'Comet', 18:'Quasar', 19:'Pulsar'
};

const CO_OBJECTS = @Html.Raw(coJson);

flatpickr("#date", {
    enableTime: false,
    dateFormat: "Y-m-d",
    altInput: true,
    altFormat: "F j, Y",
    altInputClass: "input",
    defaultDate: "@existingDate"
});

(function () {
    const sel    = document.getElementById('celestialObjectId');
    const card   = document.getElementById('co-detail');
    const elName = document.getElementById('co-name');
    const elType = document.getElementById('co-type-badge');
    const elMag  = document.getElementById('co-mag');
    const elDet  = document.getElementById('co-details');

    function update() {
        const obj = CO_OBJECTS[sel.value];
        if (!obj) { card.hidden = true; return; }
        card.hidden = false;
        elName.textContent = obj.Name;
        elType.textContent = CO_TYPE[obj.Type] || '—';
        elMag.textContent  = obj.AparentMagnitude;
        elDet.textContent  = obj.Details || '—';
    }

    sel.addEventListener('change', update);
    update();
})();
</script>
}
