@model Obligatorio_N3D_342742_360021_Client.Models.ObservationNightVM

@{
    ViewData["Title"] = "Edit Observation Plan";
    string existingDate = Model?.Date ?? "";
}

<div class="page-head">
    <div>
        <h1 class="page-head__title">Edit Observation Plan</h1>
        <p class="page-head__sub">Update the details of this planned session</p>
    </div>
    <a class="btn btn--ghost" asp-controller="ObservationNights" asp-action="Index">← Back</a>
</div>

<div class="card" style="max-width: 560px;">
    <div class="card__body">
        <form method="post" asp-controller="ObservationNights" asp-action="Edit" asp-route-id="@Model?.Id" class="form-stack">

            <input type="hidden" name="requestingUserId" value="@Model?.RequestingUserId" />

            <div class="field">
                <label class="field__label" for="date">Date &amp; Time</label>
                <input id="date" name="date" type="text" class="input"
                       value="@Model?.Date" placeholder="Pick a date and time" required />
            </div>

            <div class="field">
                <label class="field__label" for="celestialObjectId">Celestial Object ID</label>
                <input id="celestialObjectId" name="celestialObjectId" type="number" class="input" min="1"
                       value="@Model?.CelestialObject?.Id" required />
            </div>

            <div class="field">
                <label class="field__label" for="details">Details</label>
                <textarea id="details" name="details" class="textarea" rows="4">@Model?.Details</textarea>
            </div>

            <div style="display:flex; gap: var(--p-space-3); margin-top: var(--p-space-2);">
                <button type="submit" class="btn btn--primary">Save changes</button>
                <a class="btn btn--ghost" asp-controller="ObservationNights" asp-action="Index">Cancel</a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
<script>
flatpickr("#date", {
    enableTime: true,
    dateFormat: "Y-m-dTH:i",
    altInput: true,
    altFormat: "F j, Y  \\a\\t H:i",
    altInputClass: "input",
    time_24hr: true,
    defaultDate: "@existingDate"
});
</script>
}
