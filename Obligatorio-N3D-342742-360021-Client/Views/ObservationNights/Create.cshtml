@{
    ViewData["Title"] = "Plan Observation Night";
    int? userId = Context.Session.GetInt32("UserId");
    var coList = ViewBag.CelestialObjects as List<Obligatorio_N3D_342742_360021_Client.Models.CelestialObjectVM> ?? new();
    var coJson = System.Text.Json.JsonSerializer.Serialize(
        coList.ToDictionary(o => o.Id, o => new { o.Id, o.Name, o.Type, o.AparentMagnitude, o.Details })
    );
}

<style>
/* ---- Two-column layout -------------------------------------------------- */
.create-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--p-space-8);
    align-items: stretch;          /* #1: stretch both columns to same height */
}
.create-col {
    display: flex;
    flex-direction: column;
    gap: var(--p-space-3);
}
.create-col--right {
    gap: var(--p-space-5);
}

/* ---- Catalog list container --------------------------------------------- */
#co-list {
    flex: 1;                       /* #1: fill remaining column height */
    min-height: 0;
    overflow-y: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-input);
    background: var(--color-surface);
}

/* #2: Custom scrollbar */
#co-list::-webkit-scrollbar        { width: 5px; }
#co-list::-webkit-scrollbar-track  { background: transparent; }
#co-list::-webkit-scrollbar-thumb  { background: #3b82f6; border-radius: 4px; }
#co-list { scrollbar-width: thin; scrollbar-color: #3b82f6 transparent; }

/* ---- Catalog row --------------------------------------------------------- */
.co-item {
    display: flex;
    width: 100%;
    align-items: center;
    gap: var(--p-space-2);
    padding: var(--p-space-2) var(--p-space-3);
    background: transparent;
    border: none;
    border-left: 3px solid transparent; /* #6: reserve space for accent border */
    border-bottom: 1px solid rgba(255, 255, 255, 0.05); /* #11: subtle divider */
    cursor: pointer;
    text-align: left;
    transition: background 0.12s, border-left-color 0.12s;
}
.co-item:last-child { border-bottom: none; }
.co-item:hover { background: var(--color-surface-raised); }

/* #6: Clear selected state */
.co-item--selected {
    background: var(--color-accent-soft) !important;
    border-left-color: var(--color-accent) !important;
}

/* #3: Catalog item name — white text, fix undefined token refs */
.co-item__name {
    flex: 1;
    font-size: 13px;
    font-weight: 500;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ---- Type badges --------------------------------------------------------- */
.co-item__badge {
    flex-shrink: 0;
    font-size: var(--text-caption);
    font-weight: var(--weight-label);
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--color-surface-raised);
    color: var(--color-text-secondary);  /* #3: default badge text */
}

/* #10: Distinct badge color per object type */
.co-item__badge[data-type-id="1"]  { /* Star — Blue */
    background: var(--p-blue-a12);
    color: var(--p-blue-300);
}
.co-item__badge[data-type-id="2"]  { /* Neutron Star — Purple */
    background: color-mix(in srgb, #7C5CFF 12%, transparent);
    color: #A98BFF;
}
.co-item__badge[data-type-id="3"]  { /* White Dwarf — Teal */
    background: color-mix(in srgb, #2DD4BF 12%, transparent);
    color: #2DD4BF;
}
.co-item__badge[data-type-id="4"]  { /* Black Hole — Red */
    background: var(--p-red-a12);
    color: var(--p-red-400);
}

/* #8: Search placeholder contrast */
#co-search::placeholder { color: #94a3b8; }

/* #4: Flatpickr today — filled accent circle (was outline-only) */
.flatpickr-day.today {
    background: var(--color-accent-soft);
    border-color: var(--color-accent);
    color: var(--color-accent);
}
.flatpickr-day.today:hover,
.flatpickr-day.today:focus {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
}

/* #9: Button hover states */
.form-actions .btn--primary:hover {
    box-shadow: 0 0 12px rgba(59, 130, 246, 0.5);
}
.form-actions .btn--ghost {
    border: 1px solid var(--color-border-soft);
}
.form-actions .btn--ghost:hover {
    border-color: var(--color-border);
    color: var(--color-text);
    background: var(--color-surface-raised);
}

/* #5: Hover tooltip */
#co-tooltip {
    display: none;
    position: fixed;
    z-index: 500;
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-input);
    box-shadow: var(--shadow-pop);
    padding: var(--p-space-3);
    font-size: var(--text-caption);
    color: var(--color-text);
    min-width: 190px;
    max-width: 260px;
    pointer-events: none;
    line-height: 1.5;
}
.co-tooltip__name {
    font-size: var(--text-body-dense);
    font-weight: var(--weight-label);
    color: #ffffff;
    margin-bottom: var(--p-space-2);
    padding-bottom: var(--p-space-2);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
}
.co-tooltip__row {
    display: flex;
    gap: var(--p-space-2);
    margin-top: var(--p-space-1);
    color: var(--color-text-secondary);
}
.co-tooltip__label {
    color: var(--color-text-muted);
    font-weight: var(--weight-label);
    min-width: 68px;
    flex-shrink: 0;
}

/* #12: Responsive — stack columns below 768px */
@@media (max-width: 768px) {
    .create-grid {
        grid-template-columns: 1fr;
    }
    #co-list {
        flex: none;
        height: 280px;
    }
}

/* ---- Flatpickr calendar — blue tone ------------------------------------ */
.flatpickr-calendar {
    border: 1px solid var(--color-accent) !important;
    border-radius: var(--radius-md) !important;
    box-shadow: 0 0 0 1px var(--color-accent-soft), var(--shadow-pop) !important;
}
.flatpickr-months {
    background: color-mix(in srgb, var(--color-accent) 18%, var(--color-surface-raised)) !important;
    border-radius: var(--radius-md) var(--radius-md) 0 0 !important;
}
.flatpickr-month, .flatpickr-prev-month, .flatpickr-next-month {
    color: #c7dfff !important;
    fill: #c7dfff !important;
}
.flatpickr-prev-month:hover svg, .flatpickr-next-month:hover svg { fill: #fff !important; }
.flatpickr-current-month {
    color: #e0eeff !important;
    font-weight: 600;
}
.flatpickr-day {
    color: #94b8e8 !important;
}
.flatpickr-day:hover, .flatpickr-day:focus {
    background: var(--color-accent-soft) !important;
    border-color: var(--color-accent) !important;
    color: #fff !important;
}
.flatpickr-day.selected, .flatpickr-day.selected:hover {
    background: var(--color-accent) !important;
    border-color: var(--color-accent) !important;
    color: #fff !important;
}
.flatpickr-day.today {
    border-color: var(--color-accent) !important;
    color: var(--color-accent) !important;
    font-weight: 700;
}
.flatpickr-weekday { color: #6b9cce !important; font-size: 11px !important; }
.flatpickr-weekdays { background: transparent !important; }
.flatpickr-innerContainer { background: var(--color-surface-raised) !important; }

/* ---- Viewport height containment --------------------------------------- */
.card {
    max-height: calc(100vh - 10rem);
    display: flex;
    flex-direction: column;
    overflow: hidden;
}
.card__body {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}
#create-form {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
}
.create-grid {
    flex: 1;
    min-height: 0;
}
.create-col {
    min-height: 0;
    overflow: hidden;
}
#co-list {
    max-height: 70%;
}
</style>

<div id="co-tooltip"></div>

<div class="page-head">
    <div>
        <h1 class="page-head__title">Plan Observation Night</h1>
        <p class="page-head__sub">Record a new observation session and request an AI sky evaluation</p>
    </div>
    <a class="btn btn--ghost" asp-controller="ObservationNights" asp-action="Index">← Back</a>
</div>

<div class="card">
    <div class="card__body">
        <form id="create-form" method="post" asp-controller="ObservationNights" asp-action="Create">

            <input type="hidden" name="requestingUserId" value="@userId" />
            <input type="hidden" id="celestialObjectId" name="celestialObjectId" />
            <input type="hidden" id="date" name="date" />

            <div class="create-grid">

                <!-- Left: object picker -->
                <div class="create-col">
                    <div class="field" style="margin: 0;">
                        <label class="field__label" for="co-search">
                            <i class="fa-solid fa-star" style="margin-right: var(--p-space-1);"></i>Celestial Object
                        </label>
                        <input type="text" id="co-search" class="input" placeholder="Search objects…" autocomplete="off" />
                    </div>

                    <div id="co-list">
                        @foreach (var obj in coList)
                        {
                            <button type="button" class="co-item"
                                    data-id="@obj.Id"
                                    data-name="@obj.Name"
                                    data-type="@obj.Type"
                                    data-magnitude="@obj.AparentMagnitude"
                                    data-details="@obj.Details">
                                <span class="co-item__name">@obj.Name</span>
                                <span class="co-item__badge" data-type-id="@obj.Type"></span>
                            </button>
                        }
                    </div>

                </div>

                <!-- Right: date, details, actions -->
                <div class="create-col create-col--right">
                    <div class="field" style="margin: 0;">
                        <label class="field__label">
                            <i class="fa-solid fa-calendar-days" style="margin-right: var(--p-space-1);"></i>Date
                        </label>
                        <div id="date-cal"></div>
                    </div>

                    <div class="field" style="margin: 0;">
                        <label class="field__label" for="details">Details</label>
                        <textarea id="details" name="details" class="textarea" rows="5"
                                  placeholder="Objects observed, conditions, equipment used…"></textarea>
                    </div>

                    <div class="form-actions" style="display: flex; gap: var(--p-space-3);">
                        <button id="submit-btn" type="submit" class="btn btn--primary" disabled>
                            <i class="fa-solid fa-moon" style="margin-right: var(--p-space-2);"></i>Log session
                        </button>
                        <a class="btn btn--ghost" asp-controller="ObservationNights" asp-action="Index">Cancel</a>
                    </div>
                </div>

            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
const CO_TYPE = {
    1:'Star', 2:'Neutron Star', 3:'White Dwarf', 4:'Black Hole',
    5:'Open Cluster', 6:'Globular Cluster', 7:'Emission Nebula',
    8:'Reflection Nebula', 9:'Planetary Nebula', 10:'Supernova Remnant',
    11:'Galaxy', 12:'Galaxy Cluster', 13:'Planet', 14:'Dwarf Planet',
    15:'Moon', 16:'Asteroid', 17:'Comet', 18:'Quasar', 19:'Pulsar'
};

// Set badge labels
document.querySelectorAll('.co-item__badge[data-type-id]').forEach(el => {
    el.textContent = CO_TYPE[el.dataset.typeId] || '—';
});

const hiddenId   = document.getElementById('celestialObjectId');
const hiddenDate = document.getElementById('date');
const submitBtn  = document.getElementById('submit-btn');
const tooltip    = document.getElementById('co-tooltip');

function updateSubmitBtn() {
    submitBtn.disabled = !(hiddenId.value && hiddenDate.value);
}

// Calendar
flatpickr("#date-cal", {
    inline: true,
    enableTime: false,
    dateFormat: "Y-m-d",
    onChange: function(selectedDates, dateStr) {
        hiddenDate.value = dateStr;
        updateSubmitBtn();
    }
});

// Tooltip positioning
function positionTooltip(e) {
    let x = e.clientX + 18;
    let y = e.clientY - 10;
    if (x + tooltip.offsetWidth > window.innerWidth - 16) {
        x = e.clientX - tooltip.offsetWidth - 18;
    }
    if (y + tooltip.offsetHeight > window.innerHeight - 16) {
        y = window.innerHeight - tooltip.offsetHeight - 16;
    }
    tooltip.style.left = x + 'px';
    tooltip.style.top  = y + 'px';
}

document.querySelectorAll('.co-item').forEach(btn => {
    btn.addEventListener('click', () => {
        document.querySelectorAll('.co-item').forEach(b => b.classList.remove('co-item--selected'));
        btn.classList.add('co-item--selected');
        hiddenId.value = btn.dataset.id;
        updateSubmitBtn();
    });

    btn.addEventListener('mouseenter', e => {
        const typeName  = CO_TYPE[btn.dataset.type] || '—';
        const rawMag    = parseFloat(btn.dataset.magnitude);
        const magnitude = isNaN(rawMag) ? '—' : 'm = ' + rawMag.toFixed(2);
        const details   = (btn.dataset.details || '').trim() || '—';
        tooltip.innerHTML =
            `<div class="co-tooltip__name">${btn.dataset.name}</div>` +
            `<div class="co-tooltip__row"><span class="co-tooltip__label">Type</span>${typeName}</div>` +
            `<div class="co-tooltip__row"><span class="co-tooltip__label">Magnitude</span>${magnitude}</div>` +
            `<div class="co-tooltip__row"><span class="co-tooltip__label">Notes</span>${details}</div>`;
        tooltip.style.display = 'block';
        positionTooltip(e);
    });

    btn.addEventListener('mousemove', positionTooltip);

    btn.addEventListener('mouseleave', () => {
        tooltip.style.display = 'none';
    });
});

// Search filter
document.getElementById('co-search').addEventListener('input', function () {
    const q = this.value.toLowerCase();
    document.querySelectorAll('.co-item').forEach(btn => {
        btn.style.display = btn.dataset.name.toLowerCase().includes(q) ? '' : 'none';
    });
});
</script>
}
