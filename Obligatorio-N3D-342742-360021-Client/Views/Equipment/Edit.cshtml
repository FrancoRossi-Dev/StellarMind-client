@model Obligatorio_N3D_342742_360021_Client.Models.EquipmentVM

@{
    ViewData["Title"] = "Edit Equipment";
}

<div class="page-head">
    <div>
        <h1 class="page-head__title">Edit Equipment</h1>
        <p class="page-head__sub">Update item details in the inventory</p>
    </div>
    <a class="btn btn--ghost" asp-controller="Equipment" asp-action="Index">← Back</a>
</div>

<div class="card" style="max-width: 600px;">
    <div class="card__body">
        <form method="post" asp-controller="Equipment" asp-action="Edit" asp-route-id="@Model?.Id" class="form-stack">

            <div class="field-row">
                <div class="field">
                    <label class="field__label" for="brand">Brand</label>
                    <input id="brand" name="brand" type="text" class="input" value="@Model?.Brand" required />
                </div>
                <div class="field">
                    <label class="field__label" for="model">Model</label>
                    <input id="model" name="model" type="text" class="input" value="@Model?.Model" required />
                </div>
            </div>

            <div class="field">
                <label class="field__label" for="equipmentType">Type</label>
                <select id="equipmentType" name="equipmentType" class="select" required onchange="updateFields(this.value)">
                    <option value="Telescope">Telescope</option>
                    <option value="Mount">Mount</option>
                    <option value="Camera">Camera</option>
                    <option value="Eyepiece">Eyepiece</option>
                </select>
            </div>

            <div class="field-row">
                <div class="field">
                    <label class="field__label" for="quantity">Total Quantity</label>
                    <input id="quantity" name="quantity" type="number" class="input" min="0" value="@Model?.Quantity" required />
                </div>
                <div class="field">
                    <label class="field__label" for="availableQuantity">Available</label>
                    <input id="availableQuantity" name="availableQuantity" type="number" class="input" min="0" value="@Model?.availableQuantity" required />
                </div>
            </div>

            @* ── Telescope ── *@
            <div id="group-telescope" style="display:none;">
                <div class="field-group-label">Telescope specs</div>
                <div class="field-row">
                    <div class="field">
                        <label class="field__label" for="aperture">Aperture</label>
                        <input id="aperture" name="aperture" type="text" class="input" value="@Model?.Aperture" placeholder="e.g. 356mm" />
                    </div>
                    <div class="field">
                        <label class="field__label" for="focalRatio">Focal Ratio</label>
                        <input id="focalRatio" name="focalRatio" type="text" class="input" value="@Model?.FocalRatio" placeholder="e.g. f/11" />
                    </div>
                </div>
                <div class="field-row">
                    <div class="field">
                        <label class="field__label" for="focalLenght">Focal Length</label>
                        <input id="focalLenght" name="focalLenght" type="text" class="input" value="@Model?.FocalLenght" placeholder="e.g. 3910mm" />
                    </div>
                    <div class="field">
                        <label class="field__label" for="weight">Weight</label>
                        <input id="weight" name="weight" type="text" class="input" value="@Model?.Weight" placeholder="e.g. 12kg" />
                    </div>
                </div>
            </div>

            @* ── Camera ── *@
            <div id="group-camera" style="display:none;">
                <div class="field-group-label">Camera specs</div>
                <div class="field-row">
                    <div class="field">
                        <label class="field__label" for="resolution">Resolution</label>
                        <input id="resolution" name="resolution" type="text" class="input" value="@Model?.Resolution" placeholder="e.g. 24MP" />
                    </div>
                    <div class="field">
                        <label class="field__label" for="pixelSize">Pixel Size</label>
                        <input id="pixelSize" name="pixelSize" type="text" class="input" value="@Model?.PixelSize" placeholder="e.g. 5.94μm" />
                    </div>
                </div>
                <div class="field">
                    <label class="field__label" for="sensorType">Sensor Type</label>
                    <select id="sensorType" name="sensorType" class="select">
                        <option value="">— Select —</option>
                        <option value="CMOS">CMOS</option>
                        <option value="CCD">CCD</option>
                    </select>
                </div>
            </div>

            @* ── Eyepiece ── *@
            <div id="group-eyepiece" style="display:none;">
                <div class="field-group-label">Eyepiece specs</div>
                <div class="field-row">
                    <div class="field">
                        <label class="field__label" for="diameter">Barrel Diameter</label>
                        <input id="diameter" name="diameter" type="text" class="input" value="@Model?.Diameter" placeholder="e.g. 31.7mm" />
                    </div>
                    <div class="field">
                        <label class="field__label" for="fieldOfView">Field of View</label>
                        <input id="fieldOfView" name="fieldOfView" type="text" class="input" value="@Model?.FieldOfView" placeholder="e.g. 52°" />
                    </div>
                </div>
            </div>

            @* ── Mount ── *@
            <div id="group-mount" style="display:none;">
                <div class="field-group-label">Mount specs</div>
                <div class="field-row">
                    <div class="field">
                        <label class="field__label" for="mountType">Mount Type</label>
                        <select id="mountType" name="mountType" class="select">
                            <option value="">— Select —</option>
                            <option value="Ecuatorial">Ecuatorial</option>
                            <option value="AltAzimutal">AltAzimutal</option>
                            <option value="Híbrida">Híbrida</option>
                        </select>
                    </div>
                    <div class="field">
                        <label class="field__label" for="weightSupport">Weight Support</label>
                        <input id="weightSupport" name="weightSupport" type="text" class="input" value="@Model?.WeightSupport" placeholder="e.g. 20kg" />
                    </div>
                </div>
                <div class="field">
                    <label style="display:flex; align-items:center; gap: var(--p-space-2); cursor:pointer;">
                        <input id="isGoTo" name="isGoTo" type="checkbox" value="true" />
                        <span class="field__label" style="margin:0;">GoTo (motorized)</span>
                    </label>
                </div>
            </div>

            <div style="display:flex; gap: var(--p-space-3); margin-top: var(--p-space-2);">
                <button type="submit" class="btn btn--primary">Save changes</button>
                <a class="btn btn--ghost" asp-controller="Equipment" asp-action="Index">Cancel</a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
<script>
function updateFields(type) {
    document.getElementById('group-telescope').style.display = type === 'Telescope' ? '' : 'none';
    document.getElementById('group-camera').style.display    = type === 'Camera'    ? '' : 'none';
    document.getElementById('group-eyepiece').style.display  = type === 'Eyepiece'  ? '' : 'none';
    document.getElementById('group-mount').style.display     = type === 'Mount'     ? '' : 'none';
}

(function () {
    const type     = '@Html.Raw(Model?.Type ?? "")';
    const sensor   = '@Html.Raw(Model?.SensorType ?? "")';
    const mount    = '@Html.Raw(Model?.MountType ?? "")';
    const isGoTo   = @((Model?.IsGoTo ?? false) ? "true" : "false");

    document.getElementById('equipmentType').value = type;
    if (sensor) document.getElementById('sensorType').value = sensor;
    if (mount)  document.getElementById('mountType').value  = mount;
    if (isGoTo) document.getElementById('isGoTo').checked   = true;
    updateFields(type);
})();
</script>
}
