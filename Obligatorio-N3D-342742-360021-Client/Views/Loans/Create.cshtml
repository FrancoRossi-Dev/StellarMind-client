@using Obligatorio_N3D_342742_360021_Client.Models
@{
    ViewData["Title"] = "New Loan Request";
    int? userId = Context.Session.GetInt32("UserId");

    var nights     = ViewBag.Nights    as List<ObservationNightVM>  ?? new List<ObservationNightVM>();
    var telescopes = ViewBag.Telescopes as List<EquipmentVM>         ?? new List<EquipmentVM>();
    var mounts     = ViewBag.Mounts    as List<EquipmentVM>         ?? new List<EquipmentVM>();
    var eyepieces  = ViewBag.Eyepieces as List<EquipmentVM>         ?? new List<EquipmentVM>();
    var cameras    = ViewBag.Cameras   as List<EquipmentVM>         ?? new List<EquipmentVM>();

    int? selectedNightId = ViewBag.SelectedNightId as int?;

    string FmtDate(string? raw) {
        if (string.IsNullOrWhiteSpace(raw)) return "—";
        return DateTime.TryParse(raw, out var d) ? d.ToString("MMM d, yyyy  HH:mm") : raw;
    }

    string OptionLabel(EquipmentVM e) =>
        e.availableQuantity <= 0
            ? $"[!] {e.Brand} {e.Model}"
            : $"{e.Brand} {e.Model}";
}

<div class="page-head">
    <div>
        <h1 class="page-head__title">New Loan Request</h1>
        <p class="page-head__sub">Select a planned observation night and confirm the equipment set</p>
    </div>
    <a class="btn btn--ghost" asp-controller="ObservationNights" asp-action="Index">← Back</a>
</div>

<div class="card" style="max-width: 560px;">
    <div class="card__body">

        @if (!nights.Any())
        {
            <div class="empty">
                <div class="empty__icon"><i class="fa-solid fa-moon"></i></div>
                <p class="empty__title">No nights available</p>
                <p class="empty__body">All your planned nights already have an equipment request, or you haven't planned any yet.</p>
                <a class="btn btn--primary" asp-controller="ObservationNights" asp-action="Create">Plan a night</a>
            </div>
        }
        else
        {
            <form method="post" asp-controller="Loans" asp-action="Create" class="form-stack">

                <div class="field">
                    <label class="field__label" for="nightSelector">Observation Plan</label>
                    <select id="nightSelector" name="observationNightId" class="select" required onchange="fillNight(this.value)">
                        <option value="">— Select a planned night —</option>
                        @foreach (var night in nights)
                        {
                            <option value="@night.Id" @(night.Id == selectedNightId ? "selected" : "")>
                                @FmtDate(night.Date) — @(night.CelestialObject?.Name ?? "Unknown object")
                            </option>
                        }
                    </select>
                </div>

                <div class="field-group-label">Equipment</div>

                @* ── Telescope (required) ── *@
                <div class="field-row">
                    <div class="field">
                        <label class="field__label" for="telescopeId">Telescope</label>
                        <div style="display:flex; align-items:center; gap: var(--p-space-2);">
                            <select id="telescopeId" name="telescopeId" class="select" required
                                    style="flex:1;" onchange="checkStock('telescope', this)">
                                <option value="">— Select —</option>
                                @foreach (var e in telescopes)
                                {
                                    <option value="@e.Id" data-available="@e.availableQuantity">@OptionLabel(e)</option>
                                }
                            </select>
                            <i id="warn-telescope" class="fa-solid fa-triangle-exclamation"
                               style="display:none; color: var(--color-warning); flex-shrink:0;"
                               title="This item is currently out of stock. Consult a coordinator about the return date for an available unit."></i>
                        </div>
                    </div>

                    @* ── Mount (required) ── *@
                    <div class="field">
                        <label class="field__label" for="mountId">Mount</label>
                        <div style="display:flex; align-items:center; gap: var(--p-space-2);">
                            <select id="mountId" name="mountId" class="select" required
                                    style="flex:1;" onchange="checkStock('mount', this)">
                                <option value="">— Select —</option>
                                @foreach (var e in mounts)
                                {
                                    <option value="@e.Id" data-available="@e.availableQuantity">@OptionLabel(e)</option>
                                }
                            </select>
                            <i id="warn-mount" class="fa-solid fa-triangle-exclamation"
                               style="display:none; color: var(--color-warning); flex-shrink:0;"
                               title="This item is currently out of stock. Consult a coordinator about the return date for an available unit."></i>
                        </div>
                    </div>
                </div>

                @* ── Eyepiece (optional) ── *@
                <div class="field-row">
                    <div class="field">
                        <label class="field__label" for="eyepieceId">
                            Eyepiece <span style="color:var(--color-text-muted); font-weight:400;">(optional)</span>
                        </label>
                        <div style="display:flex; align-items:center; gap: var(--p-space-2);">
                            <select id="eyepieceId" name="eyepieceId" class="select"
                                    style="flex:1;" onchange="checkStock('eyepiece', this)">
                                <option value="">— None —</option>
                                @foreach (var e in eyepieces)
                                {
                                    <option value="@e.Id" data-available="@e.availableQuantity">@OptionLabel(e)</option>
                                }
                            </select>
                            <i id="warn-eyepiece" class="fa-solid fa-triangle-exclamation"
                               style="display:none; color: var(--color-warning); flex-shrink:0;"
                               title="This item is currently out of stock. Consult a coordinator about the return date for an available unit."></i>
                        </div>
                    </div>

                    @* ── Camera (optional) ── *@
                    <div class="field">
                        <label class="field__label" for="cameraId">
                            Camera <span style="color:var(--color-text-muted); font-weight:400;">(optional)</span>
                        </label>
                        <div style="display:flex; align-items:center; gap: var(--p-space-2);">
                            <select id="cameraId" name="cameraId" class="select"
                                    style="flex:1;" onchange="checkStock('camera', this)">
                                <option value="">— None —</option>
                                @foreach (var e in cameras)
                                {
                                    <option value="@e.Id" data-available="@e.availableQuantity">@OptionLabel(e)</option>
                                }
                            </select>
                            <i id="warn-camera" class="fa-solid fa-triangle-exclamation"
                               style="display:none; color: var(--color-warning); flex-shrink:0;"
                               title="This item is currently out of stock. Consult a coordinator about the return date for an available unit."></i>
                        </div>
                    </div>
                </div>

                <div style="display:flex; gap: var(--p-space-3); margin-top: var(--p-space-2);">
                    <button type="submit" class="btn btn--primary" id="submitBtn" disabled>Submit request</button>
                    <a class="btn btn--ghost" asp-controller="ObservationNights" asp-action="Index">Cancel</a>
                </div>

            </form>
        }

    </div>
</div>

@section Scripts {
<script>
function fillNight(idStr) {
    document.getElementById('submitBtn').disabled = !idStr;
}

function checkStock(type, select) {
    var opt  = select.selectedIndex >= 0 ? select.options[select.selectedIndex] : null;
    var avail = opt && opt.value ? parseInt(opt.dataset.available ?? '1', 10) : 1;
    var icon = document.getElementById('warn-' + type);
    if (icon) icon.style.display = (avail <= 0) ? 'inline' : 'none';
}

@if (selectedNightId.HasValue)
{
    <text>document.addEventListener('DOMContentLoaded', function () { fillNight('@selectedNightId.Value'); });</text>
}
</script>
}
