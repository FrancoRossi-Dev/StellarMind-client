@model List<Obligatorio_N3D_342742_360021_Client.Models.PendingLoanRequestVM>

@{
    ViewData["Title"] = "Loan Requests";
    string? role    = Context.Session.GetString("UserRole");
    bool isCoord    = role == "Coordinator" || role == "Admin";

    string FmtDate(string? raw) {
        if (string.IsNullOrWhiteSpace(raw)) return "—";
        return DateTime.TryParse(raw, out var d) ? d.ToString("MMM d, yyyy") : raw;
    }

    string StatusColor(string s) => s switch {
        "Pending"  => "var(--color-warning)",
        "Approved" => "var(--color-success)",
        "Rejected" => "var(--color-danger)",
        _          => "var(--color-text-muted)"
    };

    string AiColor(string? ai) => ai switch {
        "IDEAL"            => "var(--color-success)",
        "ADECUADO"         => "var(--color-warning)",
        "NO_RECOMENDABLE"  => "var(--color-danger)",
        _                  => "var(--color-text-muted)"
    };
    string AiIcon(string? ai) => ai switch {
        "IDEAL"            => "fa-circle-check",
        "ADECUADO"         => "fa-circle-exclamation",
        "NO_RECOMENDABLE"  => "fa-circle-xmark",
        _                  => "fa-circle"
    };
    string AiLabel(string? ai) => ai switch {
        "IDEAL"            => "Ideal",
        "ADECUADO"         => "Adequate",
        "NO_RECOMENDABLE"  => "Not Recommended",
        _                  => "—"
    };

    var sorted = Model?
        .OrderByDescending(r => r.Status == "Pending")
        .ThenBy(r => DateTime.TryParse(r.ObservationNight?.Date, out var d) ? d : DateTime.MaxValue)
        .ToList() ?? new List<Obligatorio_N3D_342742_360021_Client.Models.PendingLoanRequestVM>();

    var ticketMap = ViewBag.RequestTicketMap as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="page-head">
    <div>
        <h1 class="page-head__title">Loan Requests</h1>
        <p class="page-head__sub">Pending equipment requests awaiting review</p>
    </div>
</div>

@if (!sorted.Any())
{
    <div class="card">
        <div class="empty">
            <div class="empty__icon"><i class="fa-solid fa-inbox"></i></div>
            <p class="empty__title">No requests yet</p>
            <p class="empty__body">No equipment requests have been submitted yet.</p>
        </div>
    </div>
}
else
{
    <div class="table-wrap">
        <table class="tbl">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Member</th>
                    <th>Observation Night</th>
                    <th>Celestial Object</th>
                    <th>Status</th>
                    @if (isCoord)
                    {
                        <th style="text-align:right;">Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var req in sorted)
                {
                    <tr>
                        <td style="color: var(--color-text-muted); font-variant-numeric: tabular-nums;">#@req.RequestId</td>
                        <td>
                            <div class="tbl__name">@(req.RequestingUser?.fullName ?? "—")</div>
                            <div class="tbl__sub">@@@(req.RequestingUser?.username ?? "")</div>
                        </td>
                        <td style="color: var(--color-text-secondary); white-space:nowrap;">
                            @FmtDate(req.ObservationNight?.Date)
                        </td>
                        <td class="tbl__name">@(req.ObservationNight?.CelestialObject?.Name ?? "—")</td>
                        <td>
                            <span style="font-size: var(--text-xs); font-weight: 600; text-transform: uppercase;
                                         letter-spacing: .04em; color: @StatusColor(req.Status);">
                                @req.Status
                            </span>
                        </td>
                        @if (isCoord)
                        {
                            <td style="text-align:right;">
                                <button type="button" class="btn btn--secondary btn--sm"
                                        onclick="openRequestModal(@req.RequestId)">
                                    <i class="fa-solid fa-circle-info" style="margin-right: var(--p-space-1);"></i>Details
                                </button>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ── Per-request detail modals (coord/admin only) ── *@
    @if (isCoord)
    {
        @foreach (var req in sorted)
        {
            var night  = req.ObservationNight;
            var eqSet  = req.EquipmentSet;
            var user   = req.RequestingUser;
            <div id="req-modal-@req.RequestId" class="modal-overlay"
                 onclick="if(event.target===this)closeRequestModal(@req.RequestId)">
                <div class="modal-panel" role="dialog" aria-modal="true"
                     style="max-width: 560px;">
                    <div class="modal-header">
                        <h2 class="modal-title">
                            <i class="fa-solid fa-file-lines" style="color: var(--color-accent); margin-right: var(--p-space-2);"></i>Request #@req.RequestId
                        </h2>
                        <button class="modal-close" onclick="closeRequestModal(@req.RequestId)" aria-label="Close">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                    <div class="modal-body">

                        @* Member info *@
                        <div>
                            <p class="modal-section__title"><i class="fa-solid fa-user" style="margin-right:4px;"></i>Member</p>
                            <dl class="detail-list">
                                <dt>Name</dt><dd>@(user?.fullName ?? "—")</dd>
                                <dt>Username</dt><dd>@@@(user?.username ?? "—")</dd>
                                <dt>Email</dt><dd>@(user?.email ?? "—")</dd>
                            </dl>
                        </div>

                        @* Observation night info *@
                        <div>
                            <p class="modal-section__title"><i class="fa-solid fa-moon" style="margin-right:4px;"></i>Observation Night</p>
                            <dl class="detail-list">
                                <dt>Date</dt><dd>@FmtDate(night?.Date)</dd>
                                <dt>Celestial Object</dt><dd>@(night?.CelestialObject?.Name ?? "—")</dd>
                                <dt>Details</dt><dd style="white-space:pre-line;">@(night?.Details is { Length: > 0 } d ? d : "—")</dd>
                            </dl>
                        </div>

                        @* Equipment set *@
                        @{
                            var eqItems = new (string Label, EquipmentItemVM? Item)[] {
                                ("Telescope", eqSet?.Telescope),
                                ("Mount",     eqSet?.Mount),
                                ("Eyepiece",  eqSet?.Eyepiece),
                                ("Camera",    eqSet?.Camera),
                            };
                            bool allAvailable = eqItems.Where(x => x.Item != null).All(x => x.Item!.IsAvailable);
                        }
                        <div>
                            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:var(--p-space-2);">
                                <p class="modal-section__title" style="margin:0;"><i class="fa-solid fa-box-open" style="margin-right:4px;"></i>Equipment</p>
                                @if (allAvailable)
                                {
                                    <span style="font-size:var(--text-xs); font-weight:600; color:var(--color-success);">
                                        <i class="fa-solid fa-circle-check" style="margin-right:3px;"></i>All in stock
                                    </span>
                                }
                                else
                                {
                                    <span style="font-size:var(--text-xs); font-weight:600; color:var(--color-warning);">
                                        <i class="fa-solid fa-triangle-exclamation" style="margin-right:3px;"></i>Some items out of stock
                                    </span>
                                }
                            </div>
                            <dl class="detail-list">
                                @foreach (var (label, item) in eqItems)
                                {
                                    <dt>@label</dt>
                                    <dd>
                                        @if (item != null)
                                        {
                                            <span>@item.Brand @item.Model</span>
                                            if (item.IsAvailable)
                                            {
                                                <i class="fa-solid fa-circle-check"
                                                   style="color:var(--color-success); margin-left:6px; font-size:var(--text-xs);"
                                                   title="In stock"></i>
                                            }
                                            else
                                            {
                                                <i class="fa-solid fa-circle-xmark"
                                                   style="color:var(--color-danger); margin-left:6px; font-size:var(--text-xs);"
                                                   title="Out of stock"></i>
                                            }
                                        }
                                        else { <span style="color:var(--color-text-muted);">—</span> }
                                    </dd>
                                }
                            </dl>
                        </div>

                        @* AI assessment *@
                        @if (req.AiIndicator is not null)
                        {
                            <div>
                                <p class="modal-section__title"><i class="fa-solid fa-robot" style="margin-right:4px;"></i>AI Assessment</p>
                                <div style="display:flex; align-items:flex-start; gap: var(--p-space-2);">
                                    <span style="font-size: var(--text-xs); font-weight: 600; text-transform: uppercase;
                                                 letter-spacing: .06em; color: @AiColor(req.AiIndicator); white-space:nowrap;">
                                        <i class="fa-solid @AiIcon(req.AiIndicator)" style="margin-right:3px;"></i>@AiLabel(req.AiIndicator)
                                    </span>
                                    @if (!string.IsNullOrEmpty(req.AiDetail))
                                    {
                                        <span style="color: var(--color-text-secondary); font-size: var(--text-sm);">@req.AiDetail</span>
                                    }
                                </div>
                            </div>
                        }

                        @* Status badge *@
                        <div>
                            <p class="modal-section__title">Status</p>
                            <span style="font-size: var(--text-xs); font-weight: 600; text-transform: uppercase;
                                         letter-spacing: .06em; color: @StatusColor(req.Status);">
                                @req.Status
                            </span>
                        </div>

                    </div>

                    @* Footer: actions only shown when Pending *@
                    @if (req.Status == "Pending")
                    {
                        <div class="modal-footer">
                            <form method="post" asp-controller="Loans" asp-action="Approve"
                                  asp-route-id="@req.RequestId"
                                  id="approve-form-@req.RequestId"
                                  style="display:flex; align-items:center; gap: var(--p-space-2); flex:1; flex-wrap:wrap;">
                                <div style="display:flex; flex-direction:column; gap:2px; flex:1; min-width:160px;">
                                    <label style="font-size: var(--text-xs); color: var(--color-text-muted); font-weight:600;"
                                           for="endDate-@req.RequestId">
                                        Return-by date <span style="color: var(--color-danger);">*</span>
                                    </label>
                                    <input type="date"
                                           id="endDate-@req.RequestId"
                                           name="endDate"
                                           class="input input--sm"
                                           required
                                           data-night-date="@(night?.Date ?? "")"
                                           style="color-scheme: dark;" />
                                    <span id="date-err-@req.RequestId"
                                          style="display:none; font-size: var(--text-xs); color: var(--color-danger);">
                                        Must be at least 7 days after the observation night.
                                    </span>
                                </div>
                                <button type="submit" class="btn btn--secondary btn--sm">
                                    <i class="fa-solid fa-check" style="margin-right: var(--p-space-1);"></i>Approve
                                </button>
                            </form>
                            <form method="post" asp-controller="Loans" asp-action="Reject"
                                  asp-route-id="@req.RequestId">
                                <button type="submit" class="btn btn--danger btn--sm">
                                    <i class="fa-solid fa-xmark" style="margin-right: var(--p-space-1);"></i>Reject
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="modal-footer" style="flex-direction:column; align-items:stretch; gap: var(--p-space-3);">
                            <div style="display:flex; gap: var(--p-space-2);">
                                @if (req.Status == "Approved" && ticketMap.TryGetValue(req.RequestId, out int ticketId))
                                {
                                    <form method="post" asp-controller="Loans" asp-action="DeleteTicket"
                                          asp-route-id="@ticketId"
                                          onsubmit="return confirm('Undo this approval? The request will return to pending.');">
                                        <button type="submit" class="btn btn--danger btn--sm">
                                            <i class="fa-solid fa-rotate-left" style="margin-right: var(--p-space-1);"></i>Undo Approval
                                        </button>
                                    </form>
                                }
                                <button type="button" class="btn btn--ghost" onclick="closeRequestModal(@req.RequestId)">Close</button>
                            </div>
                            @if (req.Status == "Approved" && !ticketMap.ContainsKey(req.RequestId))
                            {
                                <form method="post" asp-controller="Loans" asp-action="DirectIssue"
                                      asp-route-requestId="@req.RequestId"
                                      style="display:flex; align-items:flex-end; gap: var(--p-space-2); flex-wrap:wrap;
                                             padding-top: var(--p-space-3); border-top: 1px solid var(--color-border);">
                                    <div class="field" style="margin:0; min-width:140px;">
                                        <label style="font-size: var(--text-xs); color: var(--color-text-muted); font-weight:600; display:block; margin-bottom:2px;">
                                            Start date <span style="color: var(--color-danger);">*</span>
                                        </label>
                                        <input type="date" name="startDate" class="input input--sm" required
                                               value="@DateTime.Now.ToString("yyyy-MM-dd")" style="color-scheme: dark;" />
                                    </div>
                                    <div class="field" style="margin:0; min-width:140px;">
                                        <label style="font-size: var(--text-xs); color: var(--color-text-muted); font-weight:600; display:block; margin-bottom:2px;">
                                            Return-by date <span style="color: var(--color-danger);">*</span>
                                        </label>
                                        <input type="date" name="endDate" class="input input--sm" required style="color-scheme: dark;" />
                                    </div>
                                    <button type="submit" class="btn btn--secondary btn--sm">
                                        <i class="fa-solid fa-ticket" style="margin-right: var(--p-space-1);"></i>Issue Ticket Directly
                                    </button>
                                </form>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    }
}

@section Scripts {
<script>
function openRequestModal(id)  { document.getElementById('req-modal-' + id).classList.add('is-open'); }
function closeRequestModal(id) { document.getElementById('req-modal-' + id).classList.remove('is-open'); }
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape')
        document.querySelectorAll('.modal-overlay.is-open').forEach(m => m.classList.remove('is-open'));
});

// Validate return date ≥ night date + 8 days
document.querySelectorAll('[id^="approve-form-"]').forEach(function(form) {
    const requestId  = form.id.replace('approve-form-', '');
    const dateInput  = document.getElementById('endDate-' + requestId);
    const errSpan    = document.getElementById('date-err-' + requestId);
    const nightDate  = dateInput.dataset.nightDate;

    // Set min attribute dynamically
    if (nightDate) {
        const night  = new Date(nightDate);
        night.setDate(night.getDate() + 8);
        const yyyy   = night.getFullYear();
        const mm     = String(night.getMonth() + 1).padStart(2, '0');
        const dd     = String(night.getDate()).padStart(2, '0');
        dateInput.min = yyyy + '-' + mm + '-' + dd;
    }

    form.addEventListener('submit', function(e) {
        if (!dateInput.value) return; // html required handles empty
        if (nightDate) {
            const night  = new Date(nightDate);
            night.setDate(night.getDate() + 8);
            const chosen = new Date(dateInput.value);
            if (chosen < night) {
                e.preventDefault();
                errSpan.style.display = '';
                dateInput.focus();
                return;
            }
        }
        errSpan.style.display = 'none';
    });

    dateInput.addEventListener('change', function() { errSpan.style.display = 'none'; });
});
</script>
}
