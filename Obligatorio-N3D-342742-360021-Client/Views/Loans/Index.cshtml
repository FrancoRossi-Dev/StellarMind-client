@model List<Obligatorio_N3D_342742_360021_Client.Models.PendingLoanRequestVM>

@{
    ViewData["Title"] = "Loan Requests";
    bool isCoord = Context.Session.GetString("UserRole") == "Coordinator";

    string FmtDate(string? raw) {
        if (string.IsNullOrWhiteSpace(raw)) return "—";
        return DateTime.TryParse(raw, out var d) ? d.ToString("MMM d, yyyy") : raw;
    }
}

<div class="page-head">
    <div>
        <h1 class="page-head__title">Loan Requests</h1>
        <p class="page-head__sub">Pending equipment requests awaiting coordinator action</p>
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <div class="card">
        <div class="empty">
            <div class="empty__icon"><i class="fa-solid fa-inbox"></i></div>
            <p class="empty__title">No pending requests</p>
            <p class="empty__body">All loan requests have been processed — the queue is clear.</p>
        </div>
    </div>
}
else
{
    <div class="table-wrap">
        <table class="tbl">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Member</th>
                    <th>Observation Night</th>
                    <th>Telescope</th>
                    @if (isCoord)
                    {
                        <th style="text-align:right;">Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var req in Model)
                {
                    <tr>
                        <td style="color: var(--color-text-muted); font-variant-numeric: tabular-nums;">#@req.RequestId</td>
                        <td>
                            <div class="tbl__name">@(req.RequestingUser?.fullName ?? "—")</div>
                            <div class="tbl__sub">@@@(req.RequestingUser?.username ?? "")</div>
                        </td>
                        <td>
                            <div>@FmtDate(req.ObservationNight?.Date)</div>
                            <div class="tbl__sub">@(req.ObservationNight?.CelestialObject?.Name ?? "—")</div>
                        </td>
                        <td style="color: var(--color-text-secondary);">
                            @if (req.EquipmentSet?.Telescope != null)
                            {
                                <span>@req.EquipmentSet.Telescope.Brand @req.EquipmentSet.Telescope.Model</span>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>
                        @if (isCoord)
                        {
                            <td>
                                <div class="tbl__actions">
                                    <form method="post" asp-controller="Loans" asp-action="Approve" asp-route-id="@req.RequestId">
                                        <button type="submit" class="btn btn--secondary btn--sm">Approve</button>
                                    </form>
                                    <form method="post" asp-controller="Loans" asp-action="Reject" asp-route-id="@req.RequestId">
                                        <button type="submit" class="btn btn--danger btn--sm">Reject</button>
                                    </form>
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
