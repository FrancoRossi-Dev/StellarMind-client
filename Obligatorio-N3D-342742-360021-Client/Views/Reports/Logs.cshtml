@model List<Obligatorio_N3D_342742_360021_Client.Models.LogEventDto>

@{
    ViewData["Title"] = "Event Log";

    string FmtDate(string? raw) {
        if (string.IsNullOrWhiteSpace(raw)) return "—";
        return DateTime.TryParse(raw, out var d) ? d.ToString("MMM d, yyyy HH:mm") : raw;
    }

    string OperationColor(string? op) => op switch {
        "CREATE" => "var(--color-success)",
        "UPDATE" => "var(--color-accent)",
        _        => "var(--color-text-muted)"
    };

    string TableColor(string? t) => t switch {
        "LoanTickets"  => "var(--color-info, var(--color-accent))",
        "LoanRequests" => "var(--color-warning)",
        _              => "var(--color-text-muted)"
    };
}

<div class="page-head">
    <div>
        <h1 class="page-head__title">Event Log</h1>
        <p class="page-head__sub">All audit events across loan requests and tickets, most recent first</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(ViewBag.msg as string))
{
    <div class="alert alert--error" style="margin-bottom: var(--p-space-4);">@ViewBag.msg</div>
}

@if (Model == null || !Model.Any())
{
    <div class="card">
        <div class="empty">
            <div class="empty__icon"><i class="fa-solid fa-scroll"></i></div>
            <p class="empty__title">No events recorded</p>
            <p class="empty__body">No audit events have been logged yet.</p>
        </div>
    </div>
}
else
{
    <div class="table-wrap">
        <table class="tbl">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Coordinator</th>
                    <th>Table</th>
                    <th>Operation</th>
                    <th>Message</th>
                    <th style="text-align:right;">Ticket</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    <tr @(log.IsError ? "style=background:color-mix(in srgb,var(--color-danger) 6%,transparent)" : "")>
                        <td style="color: var(--color-text-secondary); white-space:nowrap; font-variant-numeric: tabular-nums;">
                            @FmtDate(log.Date)
                        </td>
                        <td style="color: var(--color-text-secondary); font-size: var(--text-sm);">
                            @(string.IsNullOrEmpty(log.Email) ? "—" : log.Email)
                        </td>
                        <td>
                            <span style="font-size: var(--text-xs); font-weight:600; text-transform:uppercase;
                                         letter-spacing:.04em; color: @TableColor(log.TableName);">
                                @(log.TableName switch {
                                    "LoanTickets"  => "Tickets",
                                    "LoanRequests" => "Requests",
                                    _              => log.TableName ?? "—"
                                })
                            </span>
                        </td>
                        <td>
                            <span style="font-size: var(--text-xs); font-weight:600; text-transform:uppercase;
                                         letter-spacing:.04em; color: @OperationColor(log.Operation);">
                                @if (log.IsError)
                                {
                                    <i class="fa-solid fa-circle-exclamation" style="margin-right:3px;"></i>
                                }
                                @log.Operation
                            </span>
                        </td>
                        <td style="color: var(--color-text-secondary); font-size: var(--text-sm); max-width:360px;">
                            @log.Message
                        </td>
                        <td style="text-align:right;">
                            @if (log.LoanTicketId.HasValue)
                            {
                                <a class="btn btn--ghost btn--sm"
                                   asp-controller="Reports"
                                   asp-action="AuditDetail"
                                   asp-route-id="@log.LoanTicketId">
                                    <i class="fa-solid fa-clock-rotate-left" style="margin-right: var(--p-space-1);"></i>#@log.LoanTicketId
                                </a>
                            }
                            else
                            {
                                <span style="color: var(--color-text-muted);">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
