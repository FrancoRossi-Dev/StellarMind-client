@model List<LoanTicketVM>

@{
    ViewData["Title"] = "Loan Audit";

    var coordinators = ViewBag.Coordinators as List<UserVM> ?? new List<UserVM>();
    int? selectedCoordId = ViewBag.SelectedCoordinatorId as int?;

    string FmtDate(string? raw) {
        if (string.IsNullOrWhiteSpace(raw)) return "—";
        return DateTime.TryParse(raw, out var d) ? d.ToString("MMM d, yyyy") : raw;
    }

    string TicketStatusColor(string s) => s switch {
        "Loaned"   => "var(--color-accent)",
        "Returned" => "var(--color-success)",
        _          => "var(--color-text-muted)"
    };
}

<div class="page-head">
    <div>
        <h1 class="page-head__title">Loan Audit</h1>
        <p class="page-head__sub">Full loan ticket history, filterable by coordinator — drill down for individual event logs</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(ViewBag.msg as string))
{
    <div class="alert alert--error" style="margin-bottom: var(--p-space-4);">@ViewBag.msg</div>
}

<div class="card" style="margin-bottom: var(--p-space-5);">
    <form method="get" asp-controller="Reports" asp-action="LoanAudit"
          style="display:flex; gap: var(--p-space-3); align-items:flex-end; flex-wrap:wrap;">
        <div class="field" style="flex:1; min-width:200px;">
            <label class="field__label" for="coordinatorId">Filter by coordinator</label>
            <select id="coordinatorId" name="coordinatorId" class="input select">
                <option value="">— All coordinators —</option>
                @foreach (var c in coordinators)
                {
                    <option value="@c.UserId" selected="@(c.UserId == selectedCoordId ? "selected" : null)">
                        @c.fullName (@c.role)
                    </option>
                }
            </select>
        </div>
        <button type="submit" class="btn btn--primary">
            <i class="fa-solid fa-filter" style="margin-right: var(--p-space-1);"></i>Filter
        </button>
        @if (selectedCoordId.HasValue)
        {
            <a class="btn btn--ghost" asp-controller="Reports" asp-action="LoanAudit">Clear</a>
        }
    </form>
</div>

@if (Model == null || !Model.Any())
{
    <div class="card">
        <div class="empty">
            <div class="empty__icon"><i class="fa-solid fa-magnifying-glass"></i></div>
            <p class="empty__title">No loan tickets found</p>
            <p class="empty__body">
                @if (selectedCoordId.HasValue)
                {
                    <text>No tickets have been issued by this coordinator yet.</text>
                }
                else
                {
                    <text>No loan tickets have been created yet.</text>
                }
            </p>
        </div>
    </div>
}
else
{
    <div class="table-wrap">
        <table class="tbl">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Member</th>
                    <th>Coordinator</th>
                    <th>Start</th>
                    <th>Return By</th>
                    <th>Status</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ticket in Model)
                {
                    var member = ticket.LoanRequest?.RequestingUser;
                    <tr>
                        <td style="color: var(--color-text-muted); font-variant-numeric: tabular-nums;">#@ticket.Id</td>
                        <td>
                            <div class="tbl__name">@(member?.fullName ?? "—")</div>
                            <div class="tbl__sub">@@@(member?.username ?? "")</div>
                        </td>
                        <td>
                            <div style="color: var(--color-text-secondary);">
                                @(string.IsNullOrEmpty(ticket.CoordinatorName) ? "—" : ticket.CoordinatorName)
                            </div>
                            @if (!string.IsNullOrEmpty(ticket.CoordinatorEmail))
                            {
                                <div class="tbl__sub">@ticket.CoordinatorEmail</div>
                            }
                        </td>
                        <td style="color: var(--color-text-secondary); white-space:nowrap; font-variant-numeric: tabular-nums;">
                            @FmtDate(ticket.StartDate)
                        </td>
                        <td style="white-space:nowrap; font-variant-numeric: tabular-nums;">
                            <span style="color: @(ticket.IsOverdue ? "var(--color-danger)" : "var(--color-text-secondary)");">
                                @FmtDate(ticket.EndDate)
                            </span>
                            @if (ticket.IsOverdue)
                            {
                                <span style="color: var(--color-danger); font-size: var(--text-xs); margin-left:4px;">
                                    <i class="fa-solid fa-triangle-exclamation"></i>
                                </span>
                            }
                        </td>
                        <td>
                            <span style="font-size: var(--text-xs); font-weight:600; text-transform:uppercase;
                                         letter-spacing:.04em; color: @TicketStatusColor(ticket.Status);">
                                @ticket.Status
                            </span>
                        </td>
                        <td style="text-align:right;">
                            <a class="btn btn--secondary btn--sm"
                               asp-controller="Reports"
                               asp-action="AuditDetail"
                               asp-route-id="@ticket.Id">
                                <i class="fa-solid fa-clock-rotate-left" style="margin-right: var(--p-space-1);"></i>View log
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
