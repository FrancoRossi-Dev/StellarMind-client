@model List<CelestialRankingItem>

@{
    ViewData["Title"] = "Celestial Ranking";

    // Type label / grouping / colour mapping is shared with the member dashboard.
    string TypeLabel(int t)  => CelestialTypeInfo.Label(t);
    string GroupColor(int t) => $"var({CelestialTypeInfo.ColorVarForType(t)})";
}

<div class="page-head">
    <div>
        <h1 class="page-head__title">Celestial Ranking</h1>
        <p class="page-head__sub">Most requested celestial objects across the club</p>
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <div class="card">
        <div class="empty">
            <div class="empty__icon"><i class="fa-solid fa-star"></i></div>
            <p class="empty__title">No observations recorded yet</p>
            <p class="empty__body">Once members plan observation nights, the most observed objects will appear here.</p>
        </div>
    </div>
}
else
{
    <div class="table-wrap">
        <table class="tbl">
            <thead>
                <tr>
                    <th style="width:48px; text-align:center;">#</th>
                    <th>Object</th>
                    <th>Type</th>
                    <th style="text-align:center;">Observations</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Count; i++)
                {
                    var item = Model[i];
                    int rank = i + 1;
                    string rankColor = rank switch {
                        1 => "var(--color-warning)",
                        2 => "var(--color-text-secondary)",
                        3 => "#cd7f32",
                        _ => "var(--color-text-muted)"
                    };
                    <tr>
                        <td style="text-align:center; font-weight:700; font-size: var(--text-sm); color: @rankColor; font-variant-numeric: tabular-nums;">
                            @if (rank <= 3)
                            {
                                <i class="fa-solid fa-medal" style="margin-right:2px;"></i>
                            }
                            @rank
                        </td>
                        <td class="tbl__name">@item.Name</td>
                        <td>
                            <span style="font-size: var(--text-xs); font-weight: 600; text-transform: uppercase;
                                         letter-spacing: .04em; color: @GroupColor(item.Type);">
                                @TypeLabel(item.Type)
                            </span>
                        </td>
                        <td style="text-align:center; font-variant-numeric: tabular-nums; color: var(--color-text-secondary);">
                            @if (item.Count.HasValue)
                            {
                                @item.Count.Value
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
