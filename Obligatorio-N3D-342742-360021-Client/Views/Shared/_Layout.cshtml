<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StellarMinds</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/design-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" asp-append-version="true" />
</head>
<body>
@{
    bool hideTopbar = ViewData["HideTopbar"] as bool? == true;
    string? sessionUsername = Context.Session.GetString("Username");
    string? sessionRole = Context.Session.GetString("UserRole");
    bool loggedIn = !string.IsNullOrEmpty(sessionUsername);

    string roleChipClass = sessionRole switch {
        "Admin"       => "chip chip--accent",
        "Coordinator" => "chip chip--info",
        _             => "chip chip--plain"
    };
}
@if (!hideTopbar)
{
    <header class="topbar">
        <a class="topbar__brand" asp-controller="Users" asp-action="Index">
            <span class="topbar__brand-icon">✦</span>
            StellarMinds
        </a>
        <span class="topbar__spacer"></span>
        @if (loggedIn)
        {
            <div class="topbar__actions">
                <div class="topbar__user-info">
                    <span>@sessionUsername</span>
                    <span class="@roleChipClass">@sessionRole</span>
                </div>
                <a class="btn btn--ghost btn--sm" asp-controller="Users" asp-action="Logout">Sign out</a>
            </div>
        }
    </header>

    <div class="page-body">
        @RenderBody()
    </div>
}
else
{
    @RenderBody()
}

<script src="~/js/toast.js" asp-append-version="true"></script>
@{
    string? _toastMsg = ViewBag.message as string ?? ViewBag.msg as string;
}
@if (!string.IsNullOrEmpty(_toastMsg))
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            Toast.show(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(_toastMsg)), 'error');
        });
    </script>
}
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
