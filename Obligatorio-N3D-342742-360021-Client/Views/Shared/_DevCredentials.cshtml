<div class="dev-creds" aria-label="Testing shortcuts">
    <p class="dev-creds__label">Testing shortcuts</p>
    <div class="dev-creds__list">
        <button type="button" class="dev-creds__card"
                onclick="fillCredentials('jperez','Admin@123')">
            <span class="dev-creds__avatar dev-creds__avatar--admin">JP</span>
            <span class="dev-creds__info">
                <span class="dev-creds__name">Juan Pérez</span>
                <span class="chip chip--accent" style="font-size:10px;">Admin</span>
            </span>
        </button>
        <button type="button" class="dev-creds__card"
                onclick="fillCredentials('vcastro','Coord@123')">
            <span class="dev-creds__avatar dev-creds__avatar--coord">VC</span>
            <span class="dev-creds__info">
                <span class="dev-creds__name">Valentina Castro</span>
                <span class="chip chip--info" style="font-size:10px;">Coordinator</span>
            </span>
        </button>
        <button type="button" class="dev-creds__card"
                onclick="fillCredentials('bdiaz','Member@123')">
            <span class="dev-creds__avatar dev-creds__avatar--member">BD</span>
            <span class="dev-creds__info">
                <span class="dev-creds__name">Bruno Díaz</span>
                <span class="chip chip--plain" style="font-size:10px;">Member</span>
            </span>
        </button>
    </div>
</div>

<script>
function fillCredentials(username, password) {
    const u = document.querySelector('input[name="username"]');
    const p = document.querySelector('input[name="password"]');
    if (u) u.value = username;
    if (p) p.value = password;
    if (u) u.focus();
}
</script>
